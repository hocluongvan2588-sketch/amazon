# ====================================================================
# VEXIM AMAZON OPERATIONS PLATFORM — ENVIRONMENT CONFIGURATION
# ====================================================================

# 1. Supabase Connection (Database & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Amazon SP-API Credentials (US Marketplace ATVPDKIKX0DER)
#    ĐỦ 5 biến đầu => /api/amazon/sync chuyển sang LIVE MODE (gọi Amazon thật).
#    Thiếu bất kỳ biến nào => SIMULATED (UI báo rõ, không giả vờ thành công).
AMAZON_SP_API_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxxxxxx
AMAZON_SP_API_CLIENT_SECRET=amzn.sp.sec.xxxxxxxxxxxx
AMAZON_SP_API_REFRESH_TOKEN=Atzr|IwEBIAxxxxxxxxxxxx
AMAZON_SP_API_AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxx
AMAZON_SP_API_AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxx
# (tuỳ chọn) session token nếu dùng IAM role tạm thời
AMAZON_SP_API_AWS_SESSION_TOKEN=
AMAZON_SP_API_AWS_REGION=us-east-1
AMAZON_SP_API_ENDPOINT=https://sellingpartnerapi-na.amazon.com
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER
# Seller ID dùng cho Listings API (/listings/v2/items/{sellerId}/{sku})
AMAZON_SELLER_ID=A2XXXXXXXXXX
# LƯU Ý: ROLE_ARN hiện chưa được dùng — connector ký SigV4 trực tiếp bằng IAM user keys

# 2b. Amazon Ads API (PPC thật — giai đoạn 2)
# Nếu seller authorize CẢ scope advertising::campaign_management thì có thể
# tái dùng 3 biến LWA của SP-API, chỉ cần thêm Profile ID:
AMAZON_ADS_PROFILE_ID=1234567890
# (tuỳ chọn override nếu Ads dùng app riêng)
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
AMAZON_ADS_REFRESH_TOKEN=
AMAZON_ADS_ENDPOINT=https://advertising-api.amazon.com

# 2c. Gán kết quả sync Amazon về 1 client trong Supabase
# (UUID cột clients.id — nếu bỏ trống sẽ lấy client đầu tiên trong DB)
AMAZON_SYNC_CLIENT_ID=

# 3. AI Copilot Gateway (OpenAI / Claude)
# -> Thêm key này để /api/chat gọi AI THẬT (không có key = dùng kịch bản fallback)
AI_GATEWAY_API_KEY=your-ai-gateway-key

# 4. Logistics Webhook Secret (forwarder gọi POST /api/webhooks/logistics)
LOGISTICS_WEBHOOK_SECRET=vexim_logistics_live_2026
